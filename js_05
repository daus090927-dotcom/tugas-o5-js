<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <script>
        // for loop
        // Perulangan pertama: menampilkan angka 1 sampai 10
        for (let i = 1; i <= 10; i++) {
        console.log(i);
        }

        // Perulangan kedua: hitungan mundur dari 5 sampai 1
        for (let i = 5; i >= 1; i--) {
        console.log(i);
        }

        // Cetak teks setelah perulangan kedua selesai
        console.log("mulai !");
    </script>
</body>
</html>



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <script>
        // while loop 
        let angka = 1;
        let total = 0;

        // Menjumlahkan angka dari 1 sampai 5 (1 + 2 + 3 + 4 + 5)
        while (angka <= 5) {
        total += angka; // Menambahkan nilai angka saat ini ke variabel total
        angka++;        // Menaikkan nilai angka sebesar 1 pada setiap putaran
        }

        // Mencetak hasil akhir variabel total di luar blok perulangan
        console.log(total);
    </script>
</body>
</html>
